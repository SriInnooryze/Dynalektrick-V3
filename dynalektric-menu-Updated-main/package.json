{
  "name": "dynalektric-enterprise-frontend",
  "version": "1.0.0",
  "description": "Enterprise frontend architecture for Dynalektric Equipment Private Limited",
  "main": "src/app.jsx",
  "scripts": {
    "clean": "node scripts/build/clean.cjs",
    "build:js": "node scripts/build/build-js.cjs",
    "build:staging": "set BUILD_MODE=staging&& node scripts/prerender/prerender.cjs",
    "build:production": "set BUILD_MODE=production&& node scripts/prerender/prerender.cjs",
    "build": "npm run clean && npm run build:js && npm run build:production",
    "prerender": "node scripts/prerender/prerender.cjs",
    "verify": "node scripts/verify/__verify_ind.cjs",
    "optimize": "node scripts/optimize/copy-assets.cjs"
  },
  "keywords": [
    "dynalektric",
    "magnetics",
    "power-electronics",
    "control-panels",
    "industrial-engineering"
  ],
  "author": "Dynalektric Engineering Team",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "puppeteer": "^25.3.0"
  }
}
